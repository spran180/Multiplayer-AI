# auto selects Groq when a key is set, otherwise the offline demo planner.
LLM_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# For a host-run backend, leave OLLAMA_BASE_URL empty to use localhost.
# Docker Compose defaults this to host.docker.internal:11434.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=180
DATABASE_PATH=data/state.sqlite3
MAX_AGENT_STEPS=12
PUBLIC_BASE_URL=http://localhost:8000
DUCKDNS_SUBDOMAIN=
DUCKDNS_HOSTNAME=
DUCKDNS_TOKEN=
APPROVAL_QUORUM=2
APPROVAL_TIMEOUT_SECONDS=300
